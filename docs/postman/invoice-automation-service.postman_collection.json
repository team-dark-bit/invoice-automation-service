          "name": "Retry electronic document submission",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/electronic-documents/{{electronicDocumentId}}/retry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "electronic-documents", "{{electronicDocumentId}}", "retry"]
            },
            "description": "Reenvía el mismo comprobante únicamente cuando está en ERROR, PENDING_SEND o SENDING durante al menos cinco minutos. Conserva serie, correlativo e idempotencyKey. Con el proveedor mock, que acepta inmediatamente, esta petición devuelve 409 para demostrar que un estado final no es reintentable."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Final document cannot be retried', () => pm.response.to.have.status(409));",
                "pm.test('Returns retry eligibility error', () => pm.expect(pm.response.json().errors[0]).to.include('cannot be retried'));"
              ]
            }
          }]
        }
