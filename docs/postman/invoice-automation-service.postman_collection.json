    {
      "name": "Invoice Drafts",
      "item": [
        {
          "name": "Create invoice draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"documentType\": \"SALES_RECEIPT\",\n  \"recipientDocumentType\": \"DNI\",\n  \"recipientDocumentNumber\": \"{{recipientDocumentNumber}}\",\n  \"currency\": \"PEN\",\n  \"items\": [\n    {\n      \"description\": \"Servicio de consultoría\",\n      \"unitCode\": \"NIU\",\n      \"quantity\": 2.5,\n      \"unitPrice\": 150.25,\n      \"discount\": 0,\n      \"taxAffectation\": \"TAXED\"\n    },\n    {\n      \"description\": \"Soporte\",\n      \"unitCode\": \"NIU\",\n      \"quantity\": 1,\n      \"unitPrice\": 50.00,\n      \"discount\": 0,\n      \"taxAffectation\": \"TAXED\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                "const draft = pm.response.json().data;",
                "pm.test('Draft has calculated totals', () => {",
                "  pm.expect(draft.status).to.eql('DRAFT');",
                "  pm.expect(draft.documentType).to.eql('SALES_RECEIPT');",
                "  pm.expect(Number(draft.subtotal)).to.eql(425.63);",
                "  pm.expect(Number(draft.taxTotal)).to.eql(76.61);",
                "  pm.expect(Number(draft.total)).to.eql(502.24);",
                "});",
                "pm.environment.set('invoiceDraftId', draft.id);"
              ]
            }
          }]
        },
        {
          "name": "Find invoice draft by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const draft = pm.response.json().data;",
                "pm.test('Returns persisted aggregate', () => {",
                "  pm.expect(draft.id).to.eql(pm.environment.get('invoiceDraftId'));",
                "  pm.expect(draft.items).to.have.length(2);",
                "  pm.expect(Number(draft.total)).to.eql(502.24);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Edit invoice draft",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"SALES_RECEIPT\",\n  \"recipientDocumentType\": \"DNI\",\n  \"recipientDocumentNumber\": \"{{recipientDocumentNumber}}\",\n  \"currency\": \"PEN\",\n  \"items\": [\n    {\"description\": \"Servicio de consultoría actualizado\", \"unitCode\": \"NIU\", \"quantity\": 2.5, \"unitPrice\": 150.25, \"discount\": 0, \"taxAffectation\": \"TAXED\"},\n    {\"description\": \"Soporte actualizado\", \"unitCode\": \"NIU\", \"quantity\": 1, \"unitPrice\": 50.00, \"discount\": 0, \"taxAffectation\": \"TAXED\"}\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}"]
            },
            "description": "Reemplaza los datos editables y recalcula todos los importes mientras el estado sea DRAFT."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const draft = pm.response.json().data;",
                "pm.test('Draft remains editable and recalculated', () => { pm.expect(draft.status).to.eql('DRAFT'); pm.expect(draft.items[0].description).to.include('actualizado'); pm.expect(Number(draft.total)).to.eql(502.24); });"
              ]
            }
          }]
        },
        {
          "name": "Approve invoice draft",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}", "approve"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Draft is approved', () => pm.expect(pm.response.json().data.status).to.eql('APPROVED'));"
              ]
            }
          }]
        },
        {
          "name": "Issue invoice draft with mock provider",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}", "issue"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const document = pm.response.json().data;",
                "pm.test('Electronic document is immutable and numbered', () => {",
                "  pm.expect(document.fullNumber).to.match(/^B001-\\d{8}$/);",
                "  pm.expect(document.providerReference).to.eql(`MOCK-${document.fullNumber}`);",
                "  pm.expect(document.status).to.eql('ACCEPTED');",
                "  pm.expect(document.emissionAt).to.be.a('string').and.not.empty;",
                "  pm.expect(document.issuer.taxId).to.eql(pm.environment.get('taxId'));",
                "  pm.expect(document.recipient.documentNumber).to.eql(pm.environment.get('recipientDocumentNumber'));",
                "  pm.expect(document.submittedAt).to.be.a('string').and.not.empty;",
                "  pm.expect(document.respondedAt).to.be.a('string').and.not.empty;",
                "});"
                ,"pm.environment.set('electronicDocumentId', document.id);"
              ]
            }
          }]
        },
        {
          "name": "Reject cancellation after numbering",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}", "cancel"]
            },
            "description": "La cancelación de un borrador DRAFT o APPROVED se realiza con este endpoint. En este punto de la colección ya existe un comprobante numerado, por lo que debe rechazarse."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                "pm.test('Numbered draft cannot be cancelled', () => pm.expect(pm.response.json().errors[0]).to.include('already has a numbered electronic document'));"
              ]
            }
          }]
        },
        {
          "name": "Repeat issue idempotently",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}", "issue"]
            },
            "description": "Repite la emisión y comprueba que no se cree otro documento ni correlativo."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Returns the original electronic document', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('electronicDocumentId')));"
              ]
            }
          }]
        },
        {
          "name": "Find issued electronic document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/electronic-documents/{{electronicDocumentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "electronic-documents", "{{electronicDocumentId}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
