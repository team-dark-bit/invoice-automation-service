{
  "info": {
    "_postman_id": "52b69070-38a2-4ec8-977d-c826106d0f7c",
    "name": "Invoice Automation Service",
    "description": "Colección versionada para probar autenticación, aislamiento multiempresa y los endpoints implementados hasta Release 8. Ejecute primero Login para capturar el JWT y luego las carpetas en el orden mostrado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "adminUsername", "value": "haroldqc", "type": "string" },
    { "key": "adminPassword", "value": "password", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Monitoring",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Comprueba que la aplicación y sus dependencias estén disponibles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Application is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login and capture JWT",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Inicia sesión con el usuario creado por Flyway V7 y guarda el JWT para las siguientes peticiones."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('JWT was returned', () => pm.expect(body.data.token).to.be.a('string').and.not.empty);",
                "if (body.data && body.data.token) {",
                "  pm.environment.set('accessToken', body.data.token);",
                "  pm.collectionVariables.set('accessToken', body.data.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get authenticated user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Returns authenticated user', () => pm.expect(pm.response.json().data.username).to.eql(pm.environment.get('adminUsername')));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Create company",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.environment.set('taxId', `20${suffix.slice(-9)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Company was created', () => pm.expect(body.data.id).to.be.a('string').and.not.empty);",
                  "pm.environment.set('companyId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legalName\": \"Postman Test SAC\",\n  \"tradeName\": \"Postman Test\",\n  \"taxId\": \"{{taxId}}\",\n  \"address\": \"Lima\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "companies"]
            }
          }
        },
        {
          "name": "Configure issuer tax profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taxpayerType\": \"LEGAL_ENTITY\",\n  \"fiscalAddress\": \"Av. Lima 123\",\n  \"ubigeo\": \"150101\",\n  \"department\": \"Lima\",\n  \"province\": \"Lima\",\n  \"district\": \"Lima\",\n  \"countryCode\": \"PE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies/{{companyId}}/tax-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "companies", "{{companyId}}", "tax-profile"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Issuer onboarding completed', () => pm.expect(pm.response.json().data.completed).to.eql(true));"
              ]
            }
          }]
        },
        {
          "name": "Get issuer tax profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies/{{companyId}}/tax-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "companies", "{{companyId}}", "tax-profile"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Tax profile belongs to company', () => pm.expect(pm.response.json().data.companyId).to.eql(pm.environment.get('companyId')));"
              ]
            }
          }]
        },
        {
          "name": "Find company by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "companies", "{{companyId}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Returns requested company', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('companyId')));"
              ]
            }
          }]
        },
        {
          "name": "List active companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "companies"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Returns an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('documentNumber', Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response reports creation', () => pm.expect(pm.response.json().statusCode).to.eql(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Company-Id", "value": "{{companyId}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Customer\",\n  \"companyName\": \"Postman Test SAC\",\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{documentNumber}}\",\n  \"phoneNumber\": \"999999999\",\n  \"active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "List active customers and capture ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Company-Id", "value": "{{companyId}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const customers = pm.response.json().data;",
                "const customer = customers.find(item => item.documentNumber === pm.environment.get('documentNumber'));",
                "pm.test('Created customer is listed', () => pm.expect(customer).to.exist);",
                "if (customer) pm.environment.set('customerId', customer.id);"
              ]
            }
          }]
        },
        {
          "name": "Find customer by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Company-Id", "value": "{{companyId}}", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Returns requested customer', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('customerId')));"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Recipients",
      "item": [
        {
          "name": "Resolve recipient by DNI",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.environment.set('recipientDocumentNumber', Date.now().toString().slice(-8));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const recipient = pm.response.json().data;",
                  "pm.test('Recipient is resolved', () => pm.expect(recipient.documentNumber).to.eql(pm.environment.get('recipientDocumentNumber')));",
                  "pm.environment.set('customerId', recipient.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Company-Id", "value": "{{companyId}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{recipientDocumentNumber}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/recipients/resolve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "recipients", "resolve"]
            }
          }
        }
      ]
    },
    {
      "name": "Invoice Drafts",
      "item": [
        {
          "name": "Create invoice draft",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"documentType\": \"SALES_RECEIPT\",\n  \"recipientDocumentType\": \"DNI\",\n  \"recipientDocumentNumber\": \"{{recipientDocumentNumber}}\",\n  \"currency\": \"PEN\",\n  \"items\": [\n    {\n      \"description\": \"Servicio de consultoría\",\n      \"quantity\": 2.5,\n      \"unitPrice\": 150.25\n    },\n    {\n      \"description\": \"Soporte\",\n      \"quantity\": 1,\n      \"unitPrice\": 50.00\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                "const draft = pm.response.json().data;",
                "pm.test('Draft has calculated totals', () => {",
                "  pm.expect(draft.status).to.eql('DRAFT');",
                "  pm.expect(draft.documentType).to.eql('SALES_RECEIPT');",
                "  pm.expect(Number(draft.total)).to.eql(425.625);",
                "});",
                "pm.environment.set('invoiceDraftId', draft.id);"
              ]
            }
          }]
        },
        {
          "name": "Find invoice draft by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const draft = pm.response.json().data;",
                "pm.test('Returns persisted aggregate', () => {",
                "  pm.expect(draft.id).to.eql(pm.environment.get('invoiceDraftId'));",
                "  pm.expect(draft.items).to.have.length(2);",
                "  pm.expect(Number(draft.total)).to.eql(425.625);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Approve invoice draft",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}", "approve"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Draft is approved', () => pm.expect(pm.response.json().data.status).to.eql('APPROVED'));"
              ]
            }
          }]
        },
        {
          "name": "Issue invoice draft with mock provider",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/invoice-drafts/{{invoiceDraftId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "invoice-drafts", "{{invoiceDraftId}}", "issue"]
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "const draft = pm.response.json().data;",
                "pm.test('Draft is issued by mock provider', () => {",
                "  pm.expect(draft.status).to.eql('ISSUED');",
                "  pm.expect(draft.providerReference).to.eql(`MOCK-${pm.environment.get('invoiceDraftId')}`);",
                "  pm.expect(draft.issuedAt).to.be.a('string').and.not.empty;",
                "});"
              ]
            }
          }]
        }
      ]
    }
  ]
}
